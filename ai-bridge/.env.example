# Copy to .env and fill in. .env is gitignored.

# Amazon Bedrock API key (Bedrock console > API keys)
AWS_BEARER_TOKEN_BEDROCK=
# Region for Bedrock calls. The us.anthropic.* model IDs in models.py need a US region.
AWS_REGION=us-east-1

# Optional bot defaults (command-line flags override these)
# SERVER_URL=http://localhost:8080
# BOT_USERNAME=monkey1
# BOT_PASSWORD=monkey1
# DECK_ID=11
# FORMAT=1
